{
  "name": "JPY-USD",
  "fetchInterval": 10000,
  "aggregateInterval": 400,
  "submitInterval": 15000,
  "feedDataFreshness": 60000,
  "feeds": [
    {
      "name": "yahoo:JPY-USD",
      "definition": {
        "url": "https://query2.finance.yahoo.com/v8/finance/chart/JPY=X",
        "headers": {
          "Content-Type": "application/json",
          "User-Agent": "Mozilla/5.0"
        },
        "method": "GET",
        "reducers": [
          {
            "function": "PARSE",
            "args": [
              "chart",
              "result"
            ]
          },
          {
            "function": "INDEX",
            "args": 0
          },
          {
            "function": "PARSE",
            "args": [
              "meta",
              "regularMarketPrice"
            ]
          },
          {
            "function": "DIVFROM",
            "args": 1
          }
        ],
        "location": "kr"
      }
    },
    {
      "name": "daum:JPY-USD",
      "definition": {
        "url": "https://m.finance.daum.net/api/exchanges/FRX.KRWJPY",
        "headers": {
          "Content-Type": "application/json",
          "referer": "https://m.finance.daum.net/api/exchanges/FRX.KRWJPY"
        },
        "method": "GET",
        "reducers": [
          {
            "function": "PARSE",
            "args": [
              "usDollarRate"
            ]
          },
          {
            "function": "DIV",
            "args": 100
          }
        ]
      }
    },
    {
      "name": "gmo:JPY-USD",
      "definition": {
        "url": "https://forex-api.coin.z.com/public/v1/ticker",
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "GET",
        "reducers": [
          {
            "function": "PARSE",
            "args": [
              "data"
            ]
          },
          {
            "function": "FIND",
            "args": {
              "key": "symbol",
              "value": "USD_JPY"
            }
          },
          {
            "function": "MEAN",
            "args": [
              "bid",
              "ask"
            ]
          },
          {
            "function": "DIVFROM",
            "args": 1
          }
        ]
      }
    }
  ]
}
