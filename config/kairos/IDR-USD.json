{
  "name": "IDR-USD",
  "fetchInterval": 10000,
  "aggregateInterval": 400,
  "submitInterval": 60000,
  "feedDataFreshness": 60000,
  "feeds": [
    {
      "name": "wise:IDR-USD",
      "definition": {
        "url": "https://wise.com/rates/live?source=USD&target=IDR",
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "GET",
        "reducers": [
          {
            "function": "PARSE",
            "args": [
              "value"
            ]
          },
          {
            "function": "DIVFROM",
            "args": 1
          }
        ]
      }
    },
    {
      "name": "coinbase:IDR-USD",
      "definition": {
        "url": "https://api.coinbase.com/v2/prices/USD-IDR/spot",
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "GET",
        "reducers": [
          {
            "function": "PARSE",
            "args": [
              "data",
              "amount"
            ]
          },
          {
            "function": "DIVFROM",
            "args": 1
          }
        ]
      }
    }
  ]
}
