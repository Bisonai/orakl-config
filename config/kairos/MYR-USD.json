{
  "name": "MYR-USD",
  "fetchInterval": 10000,
  "aggregateInterval": 400,
  "submitInterval": 60000,
  "feedDataFreshness": 60000,
  "feeds": [
    {
      "name": "yahoo:MYR-USD",
      "definition": {
        "url": "https://query2.finance.yahoo.com/v8/finance/chart/MYR=X",
        "headers": {
          "Content-Type": "application/json",
          "User-Agent": "Mozilla/5.0"
        },
        "method": "GET",
        "reducers": [
          {
            "function": "PARSE",
            "args": [
              "chart",
              "result"
            ]
          },
          {
            "function": "INDEX",
            "args": 0
          },
          {
            "function": "PARSE",
            "args": [
              "meta",
              "regularMarketPrice"
            ]
          },
          {
            "function": "DIVFROM",
            "args": 1
          }
        ],
        "location": "kr"
      }
    },
    {
      "name": "daum:MYR-USD",
      "definition": {
        "url": "https://m.finance.daum.net/api/exchanges/FRX.KRWMYR",
        "headers": {
          "Content-Type": "application/json",
          "User-Agent": "Mozilla/5.0",
          "referer": "https://m.finance.daum.net/exchanges/FRX.KRWMYR"
        },
        "method": "GET",
        "reducers": [
          {
            "function": "PARSE",
            "args": [
              "usDollarRate"
            ]
          }
        ]
      }
    },
    {
      "name": "wise:MYR-USD",
      "definition": {
        "url": "https://wise.com/rates/live?source=USD&target=MYR",
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "GET",
        "reducers": [
          {
            "function": "PARSE",
            "args": [
              "value"
            ]
          },
          {
            "function": "DIVFROM",
            "args": 1
          }
        ]
      }
    }
  ]
}
